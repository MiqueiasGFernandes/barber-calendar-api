{
  "name": "barber-calendar-api",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "imports": {
    "#scheduling/*": "./dist/modules/scheduling/*",
    "#audit/*": "./dist/modules/audit/*"
  },
  "engines": {
    "node": ">=24.0.0 <25",
    "yarn": ">=4.18.0 <5"
  },
  "packageManager": "yarn@4.18.1",
  "dependenciesMeta": {
    "unrs-resolver": {
      "built": true
    }
  },
  "scripts": {
    "build": "nest build",
    "start:dev": "nest start --watch",
    "start:prod": "node --enable-source-maps dist/main.js",
    "worker": "node --enable-source-maps dist/worker.js",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:contract": "vitest run --config vitest.contract.config.ts",
    "test:e2e": "sh scripts/test-e2e.sh",
    "contract:types": "yarn openapi-typescript specs/001-tenant-authentication/contracts/openapi.yaml -o src/shared/http/openapi-types.ts && yarn openapi-typescript specs/002-appointment-scheduling/contracts/openapi.yaml -o src/modules/scheduling/infrastructure/http/openapi-types.ts",
    "contract:check": "sh scripts/check-openapi.sh",
    "docs:openapi": "node scripts/build-openapi.ts",
    "schema:check": "sh scripts/check-schema-drift.sh",
    "ci:check": "sh scripts/check-ci.sh",
    "prepare": "node .husky/install.mjs"
  },
  "dependencies": {
    "@fastify/helmet": "13.1.1",
    "@nestjs/common": "12.1.2",
    "@nestjs/core": "12.1.2",
    "@nestjs/platform-fastify": "12.1.2",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/exporter-metrics-otlp-http": "0.223.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.223.0",
    "@opentelemetry/resources": "2.12.0",
    "@opentelemetry/sdk-metrics": "2.12.0",
    "@opentelemetry/sdk-trace-base": "2.12.0",
    "fastify": "5.12.5",
    "jose": "6.2.12",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@nestjs/cli": "12.0.8",
    "@nestjs/testing": "12.1.2",
    "@types/node": "24.19.1",
    "@types/pg": "8.23.1",
    "@vitest/coverage-v8": "5.0.3",
    "ajv": "8.20.0",
    "eslint": "10.12.0",
    "eslint-plugin-import-x": "4.17.1",
    "husky": "9.1.7",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.3",
    "vitest": "5.0.3",
    "yaml": "2.9.1"
  }
}
