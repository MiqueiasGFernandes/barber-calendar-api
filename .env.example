POSTGRES_ADMIN_PASSWORD=set-a-local-admin-secret
BARBER_RUNTIME_PASSWORD=set-a-distinct-runtime-secret
DATABASE_URL=postgres://barber_runtime:set-a-distinct-runtime-secret@db:5432/barber_calendar_e2e
AUTH_SESSION_TTL=PT24H
OTP_HMAC_KEY=replace-with-32-byte-secret
# Usado para HMAC dos limites de autenticação e agendamento público; nunca registrar IP bruto.
THROTTLE_HMAC_KEY=replace-with-a-distinct-32-byte-secret
# Gerar separadamente: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
OUTBOX_ENCRYPTION_KEY=replace-with-outbox-base64-32-random-bytes
# Chave própria para respostas idempotentes, inclusive dados pessoais administrativos; replay válido por 24h e limpeza oportunista de expirados.
IDEMPOTENCY_ENCRYPTION_KEY=replace-with-idempotency-base64-32-random-bytes
JWT_PRIVATE_KEY=replace-with-pem
JWT_PUBLIC_KEY=replace-with-pem
JWT_KEY_ID=local-1
JWT_ISSUER=barber-calendar-api
JWT_AUDIENCE=barber-calendar
EMAIL_PROVIDER=mailpit
# Vazio confia apenas na conexão; configurar somente CIDRs reais de proxies confiáveis.
TRUSTED_PROXY_CIDRS=
MAILPIT_BASE_URL=http://localhost:8025
BREVO_API_KEY=
# Opcional: endpoints OTLP HTTP individuais para traces e métricas.
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://otel-collector:4318/v1/traces
# OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=http://otel-collector:4318/v1/metrics
# Fuso, intervalo e antecedência são configurados por API, não por env: America/Sao_Paulo e 15/30 inicialmente.
